# schedutil is the default governor: conservative ramps too slowly and makes
# the UI stutter on these SoCs. Don't include this config along with perf.config.
CONFIG_SLM_UV=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
# CONFIG_CPU_FREQ_DEFAULT_GOV_CONSERVATIVE is not set
# CONFIG_CPU_FREQ_DEFAULT_GOV_POWERSAVE is not set
CONFIG_HZ_100=y
# CONFIG_HZ_250 is not set
CONFIG_HZ=100
# CONFIG_SCHED_BORE is not set
